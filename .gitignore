# ==========================================
# SmartHire AI Master .gitignore Configuration
# ==========================================

# ── Frontend (Angular & Node.js) ──
Frontend/.angular/
Frontend/node_modules/
Frontend/dist/
**/node_modules/
**/.angular/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Backend (Spring Boot & Gradle / Maven) ──
Backend/build/
Backend/target/
Backend/.gradle/
Backend/out/
Backend/bin/
**/build/
**/.gradle/
**/target/
*.class
*.jar
*.war
*.ear
*.zip
*.tar.gz

# ── Python OpenCV Microservice (PythonProctor) ──
PythonProctor/venv/
**/venv/
**/ENV/
**/env/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.Python
.pytest_cache/
*.egg-info/
.eggs/

# ── IDEs & Code Editors ──
.idea/
.vscode/
*.iml
*.ipr
*.iws
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/

# ── Operating System Junk & Logs ──
.DS_Store
.DS_Store?
ehthumbs.db
Thumbs.db
*.log
*.tmp
*.temp
*.swp
*.bak

# ── Environment & Local Configuration ──
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
